APP_NAME=FitDeals V4
DATABASE_URL=sqlite:///./fitdeals.db

# Mercado Livre OAuth
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser EXATAMENTE igual ao URI cadastrado no DevCenter.
# Exemplo com um túnel HTTPS:
ML_REDIRECT_URI=https://SEU-ENDERECO-HTTPS/auth/mercadolivre/callback
ML_USE_PKCE=true

# Busca/coleta
MAX_PRICE=500
MIN_DISCOUNT=20
OFFERS_PER_RUN=10
INTERVAL_MINUTES=120
SEARCH_QUERIES=halteres,creatina,whey protein,tênis de corrida,camiseta academia

# Painel
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
